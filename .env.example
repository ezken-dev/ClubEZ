# ============================================================
# CLUB EZKEN DISCORD BOT ENVIRONMENT CONFIGURATION
# ============================================================

# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_GUILD_ID=your_primary_server_guild_id_here

# Gemini API Key for AI Auto-Moderation (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Channel IDs for Club EZKEN Server Logging & Alerts
LOG_CHANNEL_ID=123456789012345678      # #mod-logs (Audit logging)
MOD_ALERT_CHANNEL_ID=123456789012345678 # #mod-alerts (AI flagged toxic alerts)
REPORT_CHANNEL_ID=123456789012345678    # #mod-reports (User submitted reports)
WELCOME_CHANNEL_ID=123456789012345678   # #lounge-welcome (Canvas welcome cards)
ANNOUNCE_CHANNEL_ID=123456789012345678  # #announcements (YouTube stream alerts)

# Role IDs for Club EZKEN
DEFAULT_ROLE_ID=123456789012345678      # @INITIATE / @Member given on join
STREAM_PING_ROLE_ID=123456789012345678  # @Stream Ping role ID

# YouTube Channel ID for stream/video RSS polling (peaceRifat)
YOUTUBE_CHANNEL_ID=UCZlA8UMbRHcjN1m0ENVl3MA

# Database Path (default: ./data/ezken.sqlite)
DATABASE_PATH=./data/ezken.sqlite
